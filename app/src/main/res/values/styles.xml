<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">serif</item>
        <item name="android:colorAccent">#7C9270</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFF8ED</item>
        <item name="android:navigationBarColor">#4A3E35</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="TimeSelectorTheme" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:colorAccent">#0068FF</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:windowSoftInputMode">stateAlwaysHidden</item>
    </style>
    <string name="reminder_count">已设置 %1$d 个提醒</string>
</resources>
