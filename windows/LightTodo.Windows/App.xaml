<Application x:Class="LightTodo.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Color x:Key="Ink">#202624</Color><Color x:Key="Muted">#65706B</Color><Color x:Key="Accent">#587666</Color>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/><SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text,Segoe UI"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI Variable Text,Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Background" Value="#48FFFFFF"/><Setter Property="BorderBrush" Value="#30FFFFFF"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#6FFFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI Variable Text,Segoe UI"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#72FFFFFF"/><Setter Property="BorderBrush" Value="#42FFFFFF"/><Setter Property="Padding" Value="12,9"/></Style>
  </Application.Resources>
</Application>
