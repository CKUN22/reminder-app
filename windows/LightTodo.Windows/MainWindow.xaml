<Window x:Class="LightTodo.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="轻待办" Width="1280" Height="800" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#00FFFFFF" Loaded="OnLoaded" Closing="OnClosing">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="-1" UseAeroCaptionButtons="True"/></WindowChrome.WindowChrome>
  <Grid Background="#A8F4F1E9">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="18,0,140,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="24" Height="24" CornerRadius="8" Background="#587666"><TextBlock Text="✓" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="轻待办" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Margin="12,0,0,12" Background="#38FFFFFF" CornerRadius="18" BorderBrush="#32FFFFFF" BorderThickness="1">
        <DockPanel Margin="12"><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,2"><Button x:Name="AccountButton" Click="Account_Click" Content="登录或注册" Margin="0,0,0,8"/><Border Background="#28FFFFFF" CornerRadius="12" Padding="12"><StackPanel><TextBlock x:Name="StorageTitle" Text="本地存储" FontWeight="SemiBold"/><TextBlock x:Name="StorageSubtitle" Text="数据仅保存在这台电脑" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border></StackPanel>
          <StackPanel><TextBlock Text="今天" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="10,10,0,8"/><Button Tag="today" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,2" Content="  ◉   今日待办"/><Button Tag="calendar" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,2" Content="  ▦   日历日程"/><TextBlock Text="规划" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="10,22,0,8"/><Button Tag="courses" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,2" Content="  ▤   课程表"/><Button Tag="goals" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,2" Content="  ◇   目标"/><Button Tag="stats" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,2" Content="  ↗   统计"/></StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="16,0,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="10,8,8,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="今日待办" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="AddButton" Click="Add_Click" Background="#E8587565" Foreground="White" BorderThickness="0" Padding="18,10" Content="＋  新建待办" VerticalAlignment="Center"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid x:Name="ContentHost" Margin="8,0,8,8"/></ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
